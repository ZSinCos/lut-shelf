{
  "name": "lut-preview-tool",
  "version": "1.0.0",
  "description": "LUT 实时预览工具",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "rebuild": "npx @electron/rebuild -m . -o better-sqlite3",
    "postinstall": "npx @electron/rebuild -m . -o better-sqlite3"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.lut.preview",
    "productName": "LUT 预览工具",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "exifr": "^7.1.3"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
